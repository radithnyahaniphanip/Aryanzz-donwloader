# Public DNS name pointing to the VPS public IP. Caddy provisions HTTPS automatically.
MUX_DOMAIN=mux.example.com

# Generate with: openssl rand -hex 32
# Use the SAME value as the ARYANZZ Worker secret MEDIA_MUX_TOKEN.
MUX_TOKEN=replace-with-a-long-random-secret

# Optional comma-separated CDN host suffixes if a provider uses a new media CDN.
# Add only domains verified as public media hosts.
MUX_ALLOWED_HOSTS=
