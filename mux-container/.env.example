# Generate a long random token and use the SAME value in the ARYANZZ Worker secret MEDIA_MUX_TOKEN.
MUX_TOKEN=replace-with-a-long-random-secret-at-least-64-characters

# Optional extra media CDN host suffixes, comma-separated.
# Add only domains that you have verified are official public media CDNs.
MUX_ALLOWED_HOSTS=
